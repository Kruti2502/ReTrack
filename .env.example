# =============================================================================
# ReTrack — copy this file to .env and fill it in.
#
# Everything with a VITE_ prefix is bundled into the JavaScript that runs in
# the browser. Treat all of it as public. Never put a secret here.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Cloudinary --------------------------------------------------------------
# Dashboard → the "Cloud name" shown at the top
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Settings → Upload → Upload presets → the unsigned preset you created
VITE_CLOUDINARY_UPLOAD_PRESET=our-90-days-proofs

# Root folder for every proof photo (optional, defaults to our-90-days)
VITE_CLOUDINARY_FOLDER=our-90-days

# Set to "true" only if you deployed api/cloudinary-signature.ts and configured
# the server-side variables below in Vercel.
VITE_CLOUDINARY_SIGNED_UPLOADS=false


# =============================================================================
# SERVER-ONLY — never prefixed with VITE_, never committed, never in the browser.
# Add these in the Vercel dashboard only if you turn on signed uploads.
# =============================================================================
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
